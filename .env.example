# Copy to .env and fill in.
SERVER_TOKEN=change_me
LOG_LEVEL=INFO
# true = one log line per HTTP request (method path client X-Client-ID + status)
ACCESS_LOG_HTTP=false

# Gunicorn worker count inside the backend container (Dockerfile CMD).
BACKEND_WORKERS=4

# Optional L1 cache (Redis). Compose sets redis://redis:6379/0 by default when using docker-compose.
OPTIONAL_REDIS_URL=

# Host port mappings (container side is fixed: backend=1030, frontend=80).
BACKEND_PORT_HOST=8856
FRONTEND_PORT_HOST=8855

# When migrating the main DB to Postgres: docker compose --profile postgres up -d
# POSTGRES_PASSWORD=your_secret
# DATABASE_URL=postgresql+asyncpg://gtnh:your_secret@postgres:5432/remote_gtnh_control
# SYNC_DATABASE_URL=postgresql+psycopg://gtnh:your_secret@postgres:5432/remote_gtnh_control
